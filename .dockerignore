# Secrets / local env — Railway injects real env vars; never bake .env into the image
.env
.env.*

# Python / build junk
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Local SQLite (regenerated at runtime; ephemeral on Railway)
data/*.db
data/*.db-*

# Logs, VCS, node
logs/
*.log
.git/
.gitignore
node_modules/
